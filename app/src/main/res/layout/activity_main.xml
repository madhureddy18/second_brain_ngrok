<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- App Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Second Brain"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp" />

    <!-- MIC / SPEAKER BUTTON -->
    <Button
        android:id="@+id/micButton"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:text="🎤"
        android:textSize="56sp"
        android:background="@drawable/mic_button"
        android:layout_centerInParent="true"
        android:contentDescription="Speak"
        android:focusable="true"
        android:clickable="false" />

    <!-- STATUS TEXT (Listening... / Speaking... / Long press...) -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Long press Volume Up to talk"
        android:textSize="18sp"
        android:textColor="@color/text_accent"
        android:layout_below="@id/micButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

    <!-- WAVE VISUALIZER (shown during Listening) -->
    <LinearLayout
        android:id="@+id/waveLayout"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_below="@id/statusText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <View android:layout_width="5dp" android:layout_height="8dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="18dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="28dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="22dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="14dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="26dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="10dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="20dp"
            android:background="@color/mic_listening" android:layout_marginEnd="3dp"/>
        <View android:layout_width="5dp" android:layout_height="16dp"
            android:background="@color/mic_listening"/>
    </LinearLayout>

    <!-- EQ WAVE (shown during Speaking) -->
    <LinearLayout
        android:id="@+id/eqLayout"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_below="@id/statusText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <View android:layout_width="4dp" android:layout_height="6dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="14dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="20dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="16dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="22dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="12dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="18dp"
            android:background="@color/text_accent" android:layout_marginEnd="2dp"/>
        <View android:layout_width="4dp" android:layout_height="8dp"
            android:background="@color/text_accent"/>
    </LinearLayout>

    <!-- INFO CARD (onboarding prompt / response text / vision mode) -->
    <TextView
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_below="@id/waveLayout"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        android:lineSpacingMultiplier="1.4"/>

    <!-- LANGUAGE / INTENT BADGE -->
    <TextView
        android:id="@+id/langBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textSize="12sp"
        android:textColor="@color/badge_text"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:visibility="gone"/>

</RelativeLayout>